---
// HomePage.astro — the full homepage (hero, calculator, guide, FAQ, SEO copy).
// Rendered at "/" for English and at "/{lang}/" for every other language.
import Layout from "../layouts/Layout.astro";
import Calculator from "./Calculator.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { getLangFromUrl, plain, rich, useTranslatedPath, useTranslations } from "../i18n/utils";
import type { UIKey } from "../i18n/locales/en";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = useTranslatedPath(lang)("/");
const pageUrl = new URL(home, Astro.site ?? "https://variancecalc.com").href;

const FAQ_COUNT = 11;
const faqs = Array.from({ length: FAQ_COUNT }, (_, i) => ({
  q: t(`faq.${i + 1}.q` as UIKey),
  a: t(`faq.${i + 1}.a` as UIKey),
}));

const seoParagraphs = (["seo.p1", "seo.p2", "seo.p3", "seo.p4", "seo.p5"] as const).map((k) => t(k));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: t("meta.appName"),
      url: pageUrl,
      inLanguage: lang,
      applicationCategory: "EducationalApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: plain(t("meta.appDescription")),
    },
    {
      "@type": "FAQPage",
      inLanguage: lang,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout title={t("meta.title")} description={t("meta.description")}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </Fragment>

  <SiteHeader currentPath={home} />

  <main>
    <!-- ── Hero + calculator ──────────────────────────────────── -->
    <section class="relative overflow-hidden">
      <!-- Mesh gradient: the one decorative flourish, confined to the hero -->
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="mesh"></div>
      </div>

      <!-- Watermark: faint statistics vocabulary behind the hero -->
      <div class="pointer-events-none absolute inset-0 -z-10 select-none" aria-hidden="true">
        <span data-parallax="-18" class="wm wm-a">variance</span>
        <span data-parallax="-32" class="wm wm-b">σ²</span>
        <span data-parallax="-12" class="wm wm-c">mean</span>
        <span data-parallax="-26" class="wm wm-d">Σ(x − x̄)²</span>
        <span data-parallax="-20" class="wm wm-e">s² = Σ(x − x̄)² / (n − 1)</span>
      </div>

      <div class="mx-auto max-w-5xl px-5 pt-16 pb-10 sm:px-6 sm:pt-24">
        <div class="mx-auto max-w-2xl text-center">
          <h1
            data-hero
            class="text-4xl font-semibold tracking-[-0.03em] text-ink text-balance sm:text-6xl"
          >
            {t("hero.title")}
          </h1>
          <p data-hero class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-body text-balance sm:text-lg">
            {t("hero.subtitle")}
          </p>
          <nav data-hero class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm" aria-label={t("nav.quickLinks")}>
            <a href="/about/" class="text-body transition-colors hover:text-ink">{t("nav.about")}</a>
            <span class="text-hairline" aria-hidden="true">·</span>
            <a href="/contact/" class="text-body transition-colors hover:text-ink">{t("nav.contact")}</a>
            <span class="text-hairline" aria-hidden="true">·</span>
            <a href="/privacy-policy/" class="text-body transition-colors hover:text-ink">{t("nav.privacy")}</a>
            <span class="text-hairline" aria-hidden="true">·</span>
            <a href="/terms/" class="text-body transition-colors hover:text-ink">{t("nav.terms")}</a>
          </nav>
        </div>

        <div class="mt-10 sm:mt-12">
          <Calculator />
        </div>
      </div>
    </section>

    <!-- ── Guide: sample vs population ────────────────────────── -->
    <section id="guide" class="scroll-mt-4 border-t border-hairline">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-20">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            {t("guide.title")}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-body">
            {t("guide.intro")}
          </p>
        </div>

        <div data-scroll-reveal class="mt-10 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-2">
          <article class="flex flex-col gap-4 bg-elevated p-6 sm:p-8">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-md bg-link-soft font-mono text-sm font-semibold text-link-deep">s²</span>
              <h3 class="text-lg font-semibold text-ink">{t("guide.sample.title")}</h3>
            </div>
            <p class="text-sm leading-relaxed text-body" set:html={rich(t("guide.sample.body"))} />
            <div class="tnum rounded-md border border-hairline bg-canvas px-4 py-3 text-center font-mono text-sm text-ink">
              s² = Σ(x − x̄)² / (n − 1)
            </div>
            <p class="text-sm leading-relaxed text-mute" set:html={rich(t("guide.sample.examples"))} />
          </article>

          <article class="flex flex-col gap-4 bg-elevated p-6 sm:p-8">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-md bg-well font-mono text-sm font-semibold text-ink">σ²</span>
              <h3 class="text-lg font-semibold text-ink">{t("guide.population.title")}</h3>
            </div>
            <p class="text-sm leading-relaxed text-body" set:html={rich(t("guide.population.body"))} />
            <div class="tnum rounded-md border border-hairline bg-canvas px-4 py-3 text-center font-mono text-sm text-ink">
              σ² = Σ(x − μ)² / n
            </div>
            <p class="text-sm leading-relaxed text-mute" set:html={rich(t("guide.population.examples"))} />
          </article>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-mute" set:html={rich(t("guide.note"))} />
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────── -->
    <section id="faq" class="scroll-mt-4 border-t border-hairline bg-well/40">
      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-6 sm:py-20">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {t("faq.title")}
        </h2>
        <div data-scroll-reveal class="mt-8 divide-y divide-hairline border-y border-hairline">
          {
            faqs.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 text-left text-[15px] font-medium text-ink marker:content-none [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <svg
                    class="shrink-0 text-faint transition-transform duration-200 group-open:rotate-45"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                </summary>
                <p class="pb-5 pr-8 text-sm leading-relaxed text-body">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── SEO content: about this variance calculator ───────── -->
    <section id="about" class="scroll-mt-4 border-t border-hairline">
      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-6 sm:py-20">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {t("seo.title")}
        </h2>
        <div data-scroll-reveal class="mt-6 space-y-5 text-base leading-relaxed text-body">
          {seoParagraphs.map((p) => <p set:html={rich(p)} />)}
          {
            lang === "en" && (
              <p>
                Comparing two numbers, like budget vs actual? Use the{" "}
                <a href="/percent-variance-calculator/" class="text-link hover:underline">percent variance calculator</a>{" "}
                to get the variance between two numbers as an amount and a percentage.
              </p>
            )
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .mesh {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 460px;
    filter: blur(64px);
    opacity: 0.5;
    background:
      radial-gradient(38% 55% at 18% 18%, var(--color-cyan) 0%, transparent 60%),
      radial-gradient(40% 55% at 42% 8%, var(--color-blue-bright) 0%, transparent 62%),
      radial-gradient(42% 60% at 66% 22%, var(--color-violet) 0%, transparent 60%),
      radial-gradient(36% 55% at 84% 10%, var(--color-pink) 0%, transparent 60%),
      radial-gradient(40% 60% at 96% 30%, var(--color-amber) 0%, transparent 62%);
  }

  .wm {
    position: absolute;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink);
    opacity: 0.045;
  }
  :global([data-theme="dark"]) .wm {
    opacity: 0.06;
  }
  .wm-a { left: 50%; top: 1%; translate: -50% 0; font-size: clamp(4rem, 14vw, 11rem); }
  .wm-b { left: 2%; top: 38%; font-size: clamp(5rem, 16vw, 13rem); }
  .wm-c { right: 2%; top: 55%; font-size: clamp(4rem, 13vw, 10rem); }
  .wm-d { left: 4%; bottom: 3%; font-size: clamp(1.5rem, 4vw, 3rem); }
  .wm-e { right: 3%; top: 14%; font-size: clamp(0.9rem, 2vw, 1.5rem); }

  @media (max-width: 640px) {
    .mesh {
      height: 320px;
      opacity: 0.42;
    }
  }

  /* Tone the gradient down on dark canvas so it glows rather than glares */
  :global([data-theme="dark"]) .mesh {
    opacity: 0.22;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(#calculator) {
      animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
