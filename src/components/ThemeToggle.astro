---
// ThemeToggle.astro — switches light/dark. Initial theme is set by the inline
// script in Layout.astro (saved choice → OS preference) before first paint.
---

<button
  type="button"
  id="theme-toggle"
  class="flex h-11 w-11 items-center justify-center rounded-pill text-body transition-colors hover:bg-well hover:text-ink sm:h-8 sm:w-8"
  aria-label="Switch to dark mode"
  title="Toggle dark mode"
>
  <!-- Moon: shown in light mode -->
  <svg class="dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
  <!-- Sun: shown in dark mode -->
  <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const media = matchMedia("(prefers-color-scheme: dark)");

  const current = (): Theme => (root.dataset.theme === "dark" ? "dark" : "light");

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    meta?.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#fafafa");
    btn.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
  }

  function hasSavedChoice(): boolean {
    try {
      return localStorage.getItem("theme") !== null;
    } catch {
      return false;
    }
  }

  btn.addEventListener("click", () => {
    const next: Theme = current() === "dark" ? "light" : "dark";
    apply(next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage unavailable (private mode) — toggle still works for this visit */
    }
  });

  // Follow OS changes until the user makes an explicit choice.
  media.addEventListener("change", (e) => {
    if (!hasSavedChoice()) apply(e.matches ? "dark" : "light");
  });

  apply(current());
</script>
