---
const footerLinks = [
  { href: "/about", label: "About Us" },
  { href: "/contact", label: "Contact Us" },
  { href: "/privacy-policy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms & Conditions" },
];
---

<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-5 py-10 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2 text-ink">
        <span
          class="flex h-6 w-6 items-center justify-center rounded-md bg-ink font-mono text-[13px] font-semibold text-canvas"
          aria-hidden="true">σ²</span
        >
        <span class="text-sm font-semibold tracking-tight">VarianceCalc</span>
      </div>
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" aria-label="Footer">
        {
          footerLinks.map((link) => (
            <a href={link.href} class="text-body transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="text-xs text-mute">
      No data leaves your device unless you choose to share a link. © {new Date().getFullYear()} VarianceCalc.com
    </p>
  </div>
</footer>
