---
import { languages, type Lang } from "../i18n/ui";
import {
  getLangFromUrl,
  getNeutralPath,
  isLocalizedRoute,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const footerLinks = [
  { href: "/about", label: t("footer.about") },
  { href: "/contact", label: t("footer.contact") },
  { href: "/privacy-policy", label: t("footer.privacy") },
  { href: "/terms", label: t("footer.terms") },
];

// Crawlable links to every language version of this page (or the homepage).
const neutral = getNeutralPath(Astro.url);
const target = isLocalizedRoute(neutral) ? neutral : "/";
const languageLinks = (Object.entries(languages) as [Lang, string][]).map(([code, label]) => ({
  code,
  label,
  href: translatePath(target, code),
}));
---

<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-5 py-10 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2 text-ink">
        <span
          class="flex h-6 w-6 items-center justify-center rounded-md bg-ink font-mono text-[13px] font-semibold text-canvas"
          aria-hidden="true">σ²</span
        >
        <span class="text-sm font-semibold tracking-tight">VarianceCalc</span>
      </div>
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" aria-label={t("footer.label")}>
        {
          footerLinks.map((link) => (
            <a href={link.href} class="text-body transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs" aria-label={t("lang.label")}>
      {
        languageLinks.map((l) => (
          <a
            href={l.href}
            hreflang={l.code}
            lang={l.code}
            class="text-mute transition-colors hover:text-ink aria-[current=true]:font-medium aria-[current=true]:text-ink"
            aria-current={l.code === lang ? "true" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <p class="text-xs text-mute">
      {t("footer.note")} © {new Date().getFullYear()} VarianceCalc.com
    </p>
  </div>
</footer>
