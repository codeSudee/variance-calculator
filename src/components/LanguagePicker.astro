---
// LanguagePicker.astro — disclosure menu of plain links to every language
// version. Links are real <a href>s so crawlers discover each locale, and it
// works without JavaScript (the script only adds Escape / outside-click close).
import { languages, type Lang } from "../i18n/ui";
import {
  getLangFromUrl,
  getNeutralPath,
  isLocalizedRoute,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Pages not available in every language fall back to that language's homepage.
const neutral = getNeutralPath(Astro.url);
const target = isLocalizedRoute(neutral) ? neutral : "/";

const options = (Object.entries(languages) as [Lang, string][]).map(([code, label]) => ({
  code,
  label,
  href: translatePath(target, code),
}));
---

<details class="lang-picker relative">
  <summary
    class="flex h-11 cursor-pointer items-center gap-1.5 rounded-pill px-3 text-sm text-body transition-colors select-none hover:bg-well hover:text-ink marker:content-none sm:h-8 [&::-webkit-details-marker]:hidden"
    aria-label={`${t("lang.label")}: ${languages[lang]}`}
    title={t("lang.label")}
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle>
      <path
        d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"></path>
    </svg>
    <span class="font-mono text-xs uppercase" aria-hidden="true">{lang}</span>
  </summary>
  <ul
    class="absolute right-0 z-40 mt-2 min-w-40 overflow-hidden rounded-md border border-hairline bg-elevated py-1 shadow-[0_4px_16px_rgba(0,0,0,0.08)]"
    role="list"
  >
    {
      options.map((o) => (
        <li>
          <a
            href={o.href}
            hreflang={o.code}
            lang={o.code}
            class="flex items-center justify-between gap-4 px-3.5 py-2 text-sm text-body transition-colors hover:bg-well hover:text-ink aria-[current=true]:font-medium aria-[current=true]:text-ink"
            aria-current={o.code === lang ? "true" : undefined}
          >
            {o.label}
            <span class="font-mono text-[11px] uppercase text-faint">{o.code}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".lang-picker").forEach((picker) => {
    const summary = picker.querySelector("summary");
    document.addEventListener("click", (e) => {
      if (picker.open && !picker.contains(e.target as Node)) picker.open = false;
    });
    picker.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && picker.open) {
        picker.open = false;
        summary?.focus();
      }
    });
  });
</script>
