---
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/utils";

export interface Props {
  /** Anchor links (Guide/FAQ) only resolve on the homepage; elsewhere they route back to "/". */
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const home = translatePath("/");

// About/Contact are English-only pages, so they keep their unprefixed paths.
const navLinks = [
  { href: `${home}#guide`, label: t("nav.guide") },
  { href: `${home}#faq`, label: t("nav.faq") },
  { href: "/about/", label: t("nav.about") },
  { href: "/contact/", label: t("nav.contact") },
];
---

<header class="border-b border-hairline">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-5 py-3.5 sm:px-6">
    <a href={home} class="flex shrink-0 items-center gap-2 text-ink" aria-label={t("nav.home")}>
      <span
        class="flex h-6 w-6 items-center justify-center rounded-md bg-ink font-mono text-[13px] font-semibold text-canvas"
        aria-hidden="true">σ²</span
      >
      <span class="hidden text-[15px] font-semibold tracking-tight min-[400px]:inline">VarianceCalc</span>
    </a>
    <nav class="flex items-center gap-0.5 text-sm sm:gap-1" aria-label={t("nav.primary")}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-pill px-2.5 py-2.5 whitespace-nowrap text-body transition-colors hover:bg-well hover:text-ink sm:px-3 sm:py-1.5"
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <LanguagePicker />
      <ThemeToggle />
    </nav>
  </div>
</header>
