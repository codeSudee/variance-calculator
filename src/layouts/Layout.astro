---
import "../styles/global.css";
import { ogLocales } from "../i18n/ui";
import { getAlternates, getLangFromUrl, getNeutralPath, useTranslations } from "../i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Skip-link target id (without "#"). Defaults to the homepage calculator. */
  skipTo?: string;
}

const {
  title = "Variance Calculator Online — Sample & Population Variance, with Steps",
  description = "Free variance calculator online for sample variance and population variance. Paste any data set and instantly get variance, standard deviation, mean, count, and sum of squares — with every step worked out on your real numbers.",
  image = "/og-image.png",
  skipTo = "calculator",
} = Astro.props;

const site = Astro.site ?? new URL("https://variancecalc.com");
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

// hreflang: every language version of this page (plus x-default), including itself.
// Empty for pages that only exist in English.
const alternates = getAlternates(getNeutralPath(Astro.url), site);
const alternateOgLocales = alternates.length
  ? Object.entries(ogLocales)
      .filter(([l]) => l !== lang)
      .map(([, locale]) => locale)
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Variance" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="VarianceCalc" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.ogImageAlt")} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#fafafa" />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778789012514648"
      crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2YZNGV1TBN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-2YZNGV1TBN");
    </script>

    <!-- Apply saved / system theme before first paint to avoid a flash -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = "light";
        try {
          const saved = localStorage.getItem("theme");
          theme =
            saved === "dark" || saved === "light"
              ? saved
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch {}
        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#fafafa");
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href={`#${skipTo}`}
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-canvas"
    >
      {skipTo === "calculator" ? t("skip.calculator") : t("skip.main")}
    </a>
    <slot />
  </body>
</html>
