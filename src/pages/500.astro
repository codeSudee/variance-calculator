---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Server Error — VarianceCalc"
  description="Something went wrong on our end. Please try again in a moment."
  skipTo="main-content"
  noindex
>
  <SiteHeader />

  <main id="main-content">
    <section class="border-b border-hairline">
      <div class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 py-20 text-center sm:px-6">
        <span
          class="flex h-14 w-14 items-center justify-center rounded-md bg-ink font-mono text-2xl font-semibold text-canvas"
          aria-hidden="true">σ²</span
        >
        <p class="mt-6 font-mono text-sm font-medium tracking-wide text-mute">ERROR 500</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-ink text-balance sm:text-4xl">
          Something went wrong
        </h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-body text-balance">
          An unexpected error occurred on our end. This is temporary — please try
          reloading the page in a moment.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            onclick="location.reload()"
            class="rounded-pill bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
          >
            Reload the page
          </button>
          <a
            href="/"
            class="rounded-pill border border-hairline px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-well"
          >
            Back to the calculator
          </a>
        </div>
        <p class="mt-8 text-sm text-mute">
          Still stuck? <a href="/contact" class="text-link hover:underline">Let us know</a>.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
