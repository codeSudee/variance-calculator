---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const contactEmail = "code.sudeepto@gmail.com";
---

<Layout
  title="Contact Us — VarianceCalc"
  description="Get in touch with the VarianceCalc team with questions, feedback, or bug reports."
  skipTo="main-content"
  breadcrumbs={[{ name: "Contact Us", path: "/contact/" }]}
>
  <SiteHeader currentPath="/contact/" />

  <main id="main-content">
    <section class="border-b border-hairline">
      <div class="mx-auto max-w-3xl px-5 pt-16 pb-12 sm:px-6 sm:pt-20">
        <h1 class="text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">Contact Us</h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-body sm:text-lg">
          Questions, feedback, or found something that looks wrong? We'd like to hear
          about it.
        </p>
      </div>
    </section>

    <section class="border-b border-hairline">
      <div class="mx-auto max-w-3xl px-5 py-14 sm:px-6 sm:py-16">
        <div class="rounded-lg border border-hairline bg-elevated p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-ink">Email</h2>
          <p class="mt-2 text-base leading-relaxed text-body">
            The fastest way to reach us is by email:
          </p>
          <a
            href={`mailto:${contactEmail}`}
            class="mt-3 inline-flex items-center gap-2 rounded-pill bg-well px-4 py-2 font-mono text-sm text-ink transition-colors hover:bg-hairline"
          >
            {contactEmail}
          </a>
        </div>

        <div class="mt-8 space-y-4 text-base leading-relaxed text-body">
          <h2 class="text-2xl font-semibold tracking-tight text-ink">Before you write</h2>
          <p>
            Since every calculation runs locally in your browser, we can't see your data
            and can't debug an issue by looking up your session. If you're reporting a
            calculation or parsing problem, it helps a lot to include:
          </p>
          <ul class="ml-5 list-disc space-y-1.5">
            <li>The exact input you pasted or typed</li>
            <li>Whether you had sample or population mode selected</li>
            <li>What you expected versus what the calculator showed</li>
            <li>Your browser and device (e.g. Chrome on Windows, Safari on iPhone)</li>
          </ul>
          <p>
            For anything else — feature requests, general feedback, or partnership
            questions — just email us directly.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
